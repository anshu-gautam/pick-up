# Backend API URL (required for API integration)
# Points to the pick-up-be backend service
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# OpenAI API Key (required for AI gradient generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Clerk Authentication (required - for user accounts and saved gradients)
# Get your keys from: https://dashboard.clerk.com
# Sign up at https://clerk.com and create a new application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (optional - for storing gradients and community features)
# Get your keys from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
